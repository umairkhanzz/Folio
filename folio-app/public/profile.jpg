<svg xmlns="http://www.w3.org/2000/svg" width="400" height="500" viewBox="0 0 400 500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1f3a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d1117;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="circle" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:0.2" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="400" height="500" fill="url(#bg)"/>
  <!-- Grid pattern -->
  <g opacity="0.08" stroke="#6366f1" stroke-width="0.5">
    <line x1="0" y1="50" x2="400" y2="50"/>
    <line x1="0" y1="100" x2="400" y2="100"/>
    <line x1="0" y1="150" x2="400" y2="150"/>
    <line x1="0" y1="200" x2="400" y2="200"/>
    <line x1="0" y1="250" x2="400" y2="250"/>
    <line x1="0" y1="300" x2="400" y2="300"/>
    <line x1="0" y1="350" x2="400" y2="350"/>
    <line x1="0" y1="400" x2="400" y2="400"/>
    <line x1="0" y1="450" x2="400" y2="450"/>
    <line x1="50" y1="0" x2="50" y2="500"/>
    <line x1="100" y1="0" x2="100" y2="500"/>
    <line x1="150" y1="0" x2="150" y2="500"/>
    <line x1="200" y1="0" x2="200" y2="500"/>
    <line x1="250" y1="0" x2="250" y2="500"/>
    <line x1="300" y1="0" x2="300" y2="500"/>
    <line x1="350" y1="0" x2="350" y2="500"/>
  </g>
  <!-- Avatar circle -->
  <circle cx="200" cy="190" r="90" fill="url(#circle)" stroke="#6366f1" stroke-width="1" stroke-opacity="0.4"/>
  <!-- Initials -->
  <text x="200" y="208" font-family="system-ui, sans-serif" font-size="52" font-weight="800" fill="rgba(165,180,252,0.5)" text-anchor="middle" letter-spacing="-2">MUK</text>
  <!-- Replace label -->
  <rect x="60" y="360" width="280" height="50" rx="10" fill="rgba(99,102,241,0.1)" stroke="rgba(99,102,241,0.3)" stroke-width="1"/>
  <text x="200" y="379" font-family="system-ui, sans-serif" font-size="11" fill="rgba(165,180,252,0.6)" text-anchor="middle" font-weight="600">REPLACE WITH YOUR PHOTO</text>
  <text x="200" y="398" font-family="system-ui, sans-serif" font-size="10" fill="rgba(165,180,252,0.4)" text-anchor="middle">public/profile.jpg</text>
</svg>
